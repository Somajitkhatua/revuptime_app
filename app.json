{
  "expo": {
    "name": "RevUpTime",
    "slug": "revuptime",
    "scheme": "revuptime",
    "version": "1.1.1",
    "icon": "./assets/branding/app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.revuptime.mobile"
    },
    "android": {
      "versionCode": 12,
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.revuptime.mobile",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach maintenance photos and machine documents.",
          "cameraPermission": "Capture machine nameplates and maintenance photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan and photograph industrial assets.",
          "recordAudioAndroid": false
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3c9ac6f5-b96c-41e5-a24f-21bb04ee9921"
      }
    },
    "owner": "bahu007"
  }
}
